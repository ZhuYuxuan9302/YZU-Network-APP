<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
        Android 8.1 起，读取 Wi-Fi 名称（SSID）必须授予定位权限，
        用于校验当前连接的确实是 YZU-WLAN 而不是其他无线网。
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 后台自动重连（前台服务） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Android 7.x 用老式广播创建桌面快捷方式（8.0+ 不需要） -->
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.YZUNet">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:theme="@style/Theme.YZUNet"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            自动化入口：无界面、一键触发登录。
            adb shell am start -a com.zhu.yzunet.action.QUICK_LOGIN
            追加 extra「force=true」可跳过连通性检测，强制重新认证。
        -->
        <activity
            android:name=".QuickLoginActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:resizeableActivity="true"
            android:taskAffinity=""
            android:theme="@style/Theme.YZUNet.Transparent">
            <intent-filter>
                <action android:name="com.zhu.yzunet.action.QUICK_LOGIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.AutoLoginService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
