<?xml version="1.0" encoding="utf-8"?>
<!--
    校园网认证网关（eportal）是纯 HTTP 明文页面，
    连通性检测接口同样使用 http，因此需要显式放行明文流量。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
