<Window x:Class="YzuNet.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="扬大校园网 · 一键连接"
        Height="780" Width="720" MinHeight="580" MinWidth="640"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20,16,20,4">
            <StackPanel MaxWidth="660" HorizontalAlignment="Center">

                <!-- ============ 状态卡 ============ -->
                <Border x:Name="HeroBorder" CornerRadius="16" Padding="20,18" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="YZU CAMPUS NET"
                                       Foreground="#CCFFFFFF"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    x:Name="HeroRefreshButton"
                                    Content="刷新"
                                    Style="{DynamicResource LinkButtonStyle}"
                                    Foreground="#E6FFFFFF"
                                    Click="HeroRefreshButton_Click" />
                        </Grid>

                        <TextBlock x:Name="HeroTitleText"
                                   Text="待检测"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Margin="0,10,0,0" />

                        <TextBlock x:Name="HeroDetailText"
                                   Text="尚未检测"
                                   Foreground="#D9FFFFFF"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />

                        <TextBlock x:Name="HeroServiceText"
                                   Text="服务：学校互联网服务"
                                   Foreground="#B3FFFFFF"
                                   FontSize="11"
                                   Margin="0,14,0,0" />
                    </StackPanel>
                </Border>

                <!-- ============ 账户与认证 ============ -->
                <Border Style="{DynamicResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="账户与认证"
                                       Style="{DynamicResource SectionTitleStyle}"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1"
                                    x:Name="SavedChipBorder"
                                    CornerRadius="10"
                                    Padding="10,3"
                                    Background="{DynamicResource ChipBackBrush}">
                                <TextBlock x:Name="SavedChipText"
                                           Text="未填写"
                                           FontSize="11"
                                           Foreground="{DynamicResource SubtleTextBrush}" />
                            </Border>
                        </Grid>

                        <TextBlock Text="学工号 / 用户名" Style="{DynamicResource FieldLabelStyle}" />
                        <TextBox x:Name="UserIdBox"
                                 Style="{DynamicResource InputStyle}"
                                 TextChanged="UserIdBox_TextChanged" />

                        <TextBlock Text="校园网密码" Style="{DynamicResource FieldLabelStyle}" Margin="0,10,0,4" />
                        <PasswordBox x:Name="PasswordBox1"
                                     Style="{DynamicResource PasswordInputStyle}"
                                     PasswordChanged="PasswordBox_PasswordChanged" />

                        <TextBlock Text="网络服务" Style="{DynamicResource FieldLabelStyle}" Margin="0,10,0,4" />
                        <ComboBox x:Name="ServiceCombo"
                                  Height="34"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="ServiceCombo_SelectionChanged" />

                        <Border x:Name="WifiHintBorder"
                                CornerRadius="10"
                                Padding="12,8"
                                Margin="0,12,0,0"
                                Background="{DynamicResource HintWarnBackBrush}">
                            <TextBlock x:Name="WifiHintText"
                                       Text="正在检测…"
                                       FontSize="11"
                                       Foreground="{DynamicResource WarnBrush}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="改动自动保存 · 密码用 DPAPI 加密"
                                       FontSize="11"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="ForceButton"
                                        Content="强制认证"
                                        Style="{DynamicResource LinkButtonStyle}"
                                        Click="ForceButton_Click" />
                                <Button x:Name="ClearButton"
                                        Content="清除"
                                        Style="{DynamicResource LinkButtonStyle}"
                                        Foreground="{DynamicResource DangerBrush}"
                                        Click="ClearButton_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ 自动化 ============ -->
                <Border Style="{DynamicResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="自动化" Style="{DynamicResource SectionTitleStyle}" />

                        <CheckBox x:Name="AutoConnectCheck"
                                  Content="启动程序时自动连接"
                                  Style="{DynamicResource ToggleCheckStyle}"
                                  Margin="0,0,0,8"
                                  Click="AutoConnectCheck_Click" />
                        <CheckBox x:Name="AutoReconnectCheck"
                                  Content="断线自动重连（后台常驻）"
                                  Style="{DynamicResource ToggleCheckStyle}"
                                  Margin="0,0,0,8"
                                  Click="AutoReconnectCheck_Click" />
                        <CheckBox x:Name="AutoStartCheck"
                                  Content="开机自动启动（最小化到托盘）"
                                  Style="{DynamicResource ToggleCheckStyle}"
                                  Margin="0,0,0,4"
                                  Click="AutoStartCheck_Click" />

                        <TextBlock Text="检测间隔" Style="{DynamicResource FieldLabelStyle}" Margin="0,10,0,4" />
                        <ComboBox x:Name="IntervalCombo"
                                  Height="34"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="IntervalCombo_SelectionChanged" />

                        <TextBlock Text="连通性检测地址" Style="{DynamicResource FieldLabelStyle}" Margin="0,12,0,4" />
                        <TextBox x:Name="CheckUrlBox"
                                 Style="{DynamicResource InputStyle}"
                                 LostFocus="CheckUrlBox_LostFocus" />
                    </StackPanel>
                </Border>

                <!-- ============ 运行日志 ============ -->
                <Border Style="{DynamicResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="运行日志"
                                       Style="{DynamicResource SectionTitleStyle}"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="清空"
                                    Style="{DynamicResource LinkButtonStyle}"
                                    Click="ClearLogButton_Click" />
                        </Grid>
                        <ListBox x:Name="LogList"
                                 Height="170"
                                 Background="{DynamicResource LogBackgroundBrush}"
                                 BorderThickness="0"
                                 FontFamily="Consolas, Microsoft YaHei UI"
                                 FontSize="11"
                                 Foreground="{DynamicResource SubtleTextBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </StackPanel>
                </Border>

                <Button Content="重置全部设置"
                        Style="{DynamicResource LinkButtonStyle}"
                        Foreground="{DynamicResource DangerBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,10"
                        Click="ResetButton_Click" />
            </StackPanel>
        </ScrollViewer>

        <!-- ============ 底部操作区 ============ -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel MaxWidth="660" HorizontalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            x:Name="ConnectButton"
                            Content="一键连接校园网"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Click="ConnectButton_Click" />
                    <Button Grid.Column="1"
                            x:Name="ThemeButton"
                            Content="深色"
                            Style="{DynamicResource ToolButtonStyle}"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Click="ThemeButton_Click" />
                </Grid>
                <TextBlock Text="关闭窗口会最小化到托盘，右键托盘图标可退出"
                           FontSize="11"
                           Foreground="{DynamicResource SubtleTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
