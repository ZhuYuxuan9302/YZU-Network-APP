<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色主题：只覆盖画刷，样式自动跟随 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0F141B" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#161C25" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2B3542" />
    <SolidColorBrush x:Key="TextBrush" Color="#E3E6EC" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#A7B0BE" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#7FB0FF" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#00204A" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="WarnBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1D242E" />
    <SolidColorBrush x:Key="LogBackgroundBrush" Color="#131A22" />
    <SolidColorBrush x:Key="HintSuccessBackBrush" Color="#12301F" />
    <SolidColorBrush x:Key="HintWarnBackBrush" Color="#322612" />
    <SolidColorBrush x:Key="HintDangerBackBrush" Color="#34181A" />
    <SolidColorBrush x:Key="ChipBackBrush" Color="#232B36" />

</ResourceDictionary>
